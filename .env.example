# Porta exposta no host para acessar o Postgres fora do Docker (ex.: via psql/DBeaver).
# Mude se já tiver outro Postgres usando essa porta na máquina.
DB_HOST_PORT=5433

DB_NAME=bazar
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=changeme-super-secret-key
CORS_ALLOWED_ORIGINS=http://localhost:5173
JPA_DDL_AUTO=update
